{
  "name": "@ai-sdk/gemini-cli",
  "version": "0.1.0",
  "description": "AI SDK provider for Gemini via Gemini CLI OAuth tokens",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist/**/*", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "1.1.3",
    "@ai-sdk/provider-utils": "2.2.8",
    "google-auth-library": "9.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
